# Proveedor de LLM a usar. El proyecto también soporta "openai" y "anthropic"
# (ver llm_clients.py), pero aquí solo se configura Gemini.
LLM_PROVIDER=gemini

GEMINI_API_KEY=
GEMINI_VISION_MODEL=gemini-3.5-flash

# --- PostgreSQL (backend FastAPI) ---
POSTGRES_USER=invoices
POSTGRES_PASSWORD=invoices
POSTGRES_DB=invoices
# Host "db" porque el backend corre dentro de docker-compose junto al servicio
# de Postgres. Si corres el backend fuera de Docker contra un Postgres local,
# cambia "db" por "localhost".
DATABASE_URL=postgresql+asyncpg://invoices:invoices@db:5432/invoices
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# Origen permitido por CORS (puerto por defecto del servidor de desarrollo de Vite)
FRONTEND_URL=http://localhost:5173
